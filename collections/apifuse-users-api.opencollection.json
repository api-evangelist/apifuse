{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apifuse Analytics Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apifuse List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifuse.io/users"
          },
          "docs": "Returns all users who have connected integrations."
        }
      ]
    }
  ],
  "bundled": true
}