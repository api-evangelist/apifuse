{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apifuse Analytics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apifuse Get Analytics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifuse.io/analytics",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date for analytics period (ISO 8601 date)."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date for analytics period (ISO 8601 date)."
              }
            ]
          },
          "docs": "Returns usage analytics and task counts for integrations."
        }
      ]
    }
  ],
  "bundled": true
}