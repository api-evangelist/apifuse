{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apifuse Analytics Integrations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apifuse List Integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifuse.io/integrations",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Filter integrations by category (e.g., CRM, Accounting)."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page."
              }
            ]
          },
          "docs": "Returns a list of all available integrations in the marketplace."
        },
        {
          "info": {
            "name": "Apifuse Get Integration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifuse.io/integrations/:integrationId",
            "params": [
              {
                "name": "integrationId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the integration."
              }
            ]
          },
          "docs": "Returns details for a specific integration."
        }
      ]
    }
  ],
  "bundled": true
}