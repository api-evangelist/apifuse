{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apifuse Analytics Connectors API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Connectors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apifuse List Connectors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifuse.io/connectors",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Filter connectors by category."
              }
            ]
          },
          "docs": "Returns a list of all pre-built connectors available on the platform."
        }
      ]
    }
  ],
  "bundled": true
}