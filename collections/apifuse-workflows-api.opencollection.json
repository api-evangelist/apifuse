{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apifuse Analytics Workflows API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apifuse List Workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apifuse.io/workflows"
          },
          "docs": "Returns all integration workflows configured in the account."
        },
        {
          "info": {
            "name": "Apifuse Create Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apifuse.io/workflows",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new integration workflow."
        }
      ]
    }
  ],
  "bundled": true
}